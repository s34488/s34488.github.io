/* การตั้งค่าพื้นฐาน */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Kanit', Arial, sans-serif;
}

body {
    background-color: #f4f7f6;
    color: #333;
    line-height: 1.6;
}

/* แถบเมนูด้านบน (Navigation Bar) */
nav {
    background-color: #2c3e50;
    padding: 15px 0;
    text-align: center;
    position: sticky;
    top: 0;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

nav a {
    color: #fff;
    text-decoration: none;
    margin: 0 15px;
    font-size: 1.1rem;
    font-weight: bold;
    transition: color 0.3s;
}

nav a:hover {
    color: #3498db;
}

/* กล่องเนื้อหาหลัก */
.container {
    max-width: 800px;
    margin: 50px auto;
    background: #fff;
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    min-height: 400px;
}

h1 {
    color: #2c3e50;
    margin-bottom: 20px;
    border-bottom: 3px solid #3498db;
    display: inline-block;
    padding-bottom: 5px;
}

/* ปุ่มกดสไตล์หน้าปก */
.btn {
    display: inline-block;
    background-color: #3498db;
    color: #fff;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 25px;
    font-size: 1.2rem;
    font-weight: bold;
    margin-top: 25px;
    transition: background 0.3s;
}

.btn:hover {
    background-color: #2980b9;
}

/* สไตล์หน้าปกเฉพาะ */
.cover-page {
    text-align: center;
    padding: 100px 20px;
}

.profile-img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 4px solid #3498db;
}

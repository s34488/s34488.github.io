
/* ตั้งค่าพื้นฐาน */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Arial", sans-serif;
  background: #f7f3ec;
  color: #263b50;
  line-height: 1.8;
}

/* เมนู */
.navbar {
  background: #ffffff;
  padding: 20px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 10px #00000010;
}

.navbar h2 {
  color: #244c78;
}

.nav-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.nav-links a {
  text-decoration: none;
  color: #263b50;
  font-weight: bold;
}

.nav-links a:hover {
  color: #b68b45;
}

/* หน้าปก */
.hero {
  min-height: 90vh;
  padding: 80px 10%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 50px;
  background: linear-gradient(
    135deg,
    #f7f3ec,
    #d9e8f5
  );
}

.hero-text {
  max-width: 600px;
}

.subtitle {
  letter-spacing: 5px;
  color: #b68b45;
  font-weight: bold;
}

.hero h1 {
  font-size: 48px;
  color: #244c78;
  margin: 10px 0;
}

.hero h2 {
  font-size: 24px;
  font-weight: normal;
}

.name {
  margin-top: 30px;
}

.hero-image img {
  width: 300px;
  height: 400px;
  object-fit: cover;
  border-radius: 20px;
  box-shadow: 0 10px 30px #00000020;
}

/* ปุ่ม */
.btn {
  display: inline-block;
  margin-top: 25px;
  padding: 12px 25px;
  background: #244c78;
  color: white;
  text-decoration: none;
  border-radius: 30px;
}

.btn:hover {
  background: #b68b45;
}

/* ส่วนเนื้อหา */
.section {
  padding: 90px 10%;
  min-height: 70vh;
}

.section-title {
  text-align: center;
  font-size: 36px;
  color: #244c78;
  margin-bottom: 45px;
}

.content-box {
  background: white;
  padding: 40px;
  border-radius: 20px;
  box-shadow: 0 5px 20px #00000008;
}

.content-box p {
  margin-bottom: 20px;
}

.signature {
  text-align: right;
  margin-top: 40px;
}

/* ประวัติการศึกษา */
.timeline {
  max-width: 850px;
  margin: auto;
}

.education-card {
  display: flex;
  gap: 30px;
  align-items: center;
  background: white;
  padding: 25px;
  margin-bottom: 25px;
  border-radius: 20px;
  box-shadow: 0 5px 20px #00000008;
}

.education-card img {
  width: 150px;
  height: 120px;
  object-fit: cover;
  border-radius: 15px;
}

.education-card span {
  color: #b68b45;
  font-weight: bold;
}

.education-card h3 {
  color: #244c78;
}

/* ความสนใจ */
.interest-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.interest-image img {
  width: 100%;
  max-height: 450px;
  object-fit: cover;
  border-radius: 20px;
}

.content-box h3 {
  font-size: 26px;
  color: #244c78;
  margin-bottom: 20px;
}

/* กิจกรรม */
.activity-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.activity-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 5px 20px #00000008;
  padding-bottom: 25px;
}

.activity-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.activity-card h3,
.activity-card p {
  margin: 15px 25px 0;
}

.activity-card h3 {
  color: #244c78;
}

.activity-date {
  color: #b68b45;
  font-size: 14px;
}

/* Footer */
footer {
  background: #244c78;
  color: white;
  text-align: center;
  padding: 30px;
}

/* รองรับมือถือ */
@media (max-width: 768px) {

  .navbar {
    flex-direction: column;
  }

  .nav-links {
    justify-content: center;
    gap: 12px;
  }

  .hero {
    flex-direction: column;
    text-align: center;
    padding: 60px 20px;
  }

  .hero h1 {
    font-size: 36px;
  }

  .hero h2 {
    font-size: 20px;
  }

  .hero-image img {
    width: 240px;
    height: 320px;
  }

  .section {
    padding: 60px 20px;
  }

  .section-title {
    font-size: 30px;
  }

  .content-box {
    padding: 25px;
  }

  .education-card {
    flex-direction: column;
    text-align: center;
  }

  .interest-content {
    grid-template-columns: 1fr;
  }

  .activity-grid {
    grid-template-columns: 1fr;
  }

}
